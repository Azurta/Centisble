# Get free keys at https://dashboard.plaid.com (Sandbox works immediately with fake banks)
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox
# Public URL Plaid can reach for instant "new transaction" webhooks (e.g. an ngrok URL).
# Optional: without it the server polls Plaid every POLL_MINUTES instead.
PLAID_WEBHOOK_URL=
POLL_MINUTES=15
PORT=8787
# Key that encrypts stored bank connections (required when hosted; locally one is created in data/secret.key).
# Never change it once set. Servers created before accounts existed use APP_TOKEN for this instead.
DATA_KEY=
# Optional: redirect-style bank logins. Must also be added under Allowed redirect URIs in the Plaid dashboard.
PLAID_REDIRECT_URI=
